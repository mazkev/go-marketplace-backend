### ====================================================================
### C2C Marketplace Back-End API Test Suite (.http / REST Client)
### ====================================================================

@baseUrl = http://localhost:8080/api/v1

### --------------------------------------------------------------------
### 0. Health Check
### --------------------------------------------------------------------
# @name healthCheck
GET http://localhost:8080/health
Content-Type: application/json

### --------------------------------------------------------------------
### 1. Authentication & Users
### --------------------------------------------------------------------

### 1.1 Register Seller 1
# @name registerSeller1
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Budi Seller Gadget",
  "email": "seller1@market.com",
  "password": "Password123!",
  "phone": "081234567890",
  "role": "seller"
}

### 1.2 Register Seller 2
# @name registerSeller2
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Siti Seller Fashion",
  "email": "seller2@market.com",
  "password": "Password123!",
  "phone": "081234567891",
  "role": "seller"
}

### 1.3 Register Buyer
# @name registerBuyer
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Kevin Buyer",
  "email": "buyer@market.com",
  "password": "Password123!",
  "phone": "081234567892",
  "role": "buyer"
}

### 1.4 Login Buyer
# @name loginBuyer
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "buyer@market.com",
  "password": "Password123!"
}

### Store Tokens from Responses
@buyerToken = {{loginBuyer.response.body.data.access_token}}
@seller1Token = {{registerSeller1.response.body.data.access_token}}
@seller2Token = {{registerSeller2.response.body.data.access_token}}

### 1.5 Get Buyer Profile
GET {{baseUrl}}/auth/profile
Authorization: Bearer {{buyerToken}}

### 1.6 Add Delivery Address for Buyer
# @name addAddress
POST {{baseUrl}}/user/addresses
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{
  "receiver_name": "Andi Pratama",
  "phone": "081234567892",
  "full_address": "Jl. Sudirman Kav. 21, Kebayoran Baru",
  "city_id": 1,
  "is_primary": true
}

### 1.7 Get Buyer Addresses
GET {{baseUrl}}/user/addresses
Authorization: Bearer {{buyerToken}}


### --------------------------------------------------------------------
### 2. Store / Merchant Management
### --------------------------------------------------------------------

### 2.1 Register Store 1 (Gadget Store)
# @name createStore1
POST {{baseUrl}}/stores
Authorization: Bearer {{seller1Token}}
Content-Type: application/json

{
  "store_name": "Official Gadget Store",
  "domain_slug": "gadget-store",
  "city_id": 1
}

### 2.2 Register Store 2 (Fashion Store)
# @name createStore2
POST {{baseUrl}}/stores
Authorization: Bearer {{seller2Token}}
Content-Type: application/json

{
  "store_name": "Urban Fashion Corner",
  "domain_slug": "urban-fashion",
  "city_id": 2
}

### 2.3 Get My Store (Seller 1)
GET {{baseUrl}}/seller/store
Authorization: Bearer {{seller1Token}}

### 2.4 Get Store Profile (Public)
GET {{baseUrl}}/stores/1

### 2.5 Get Store Balance (Seller 1)
GET {{baseUrl}}/seller/balance
Authorization: Bearer {{seller1Token}}


### --------------------------------------------------------------------
### 3. Categories & Products
### --------------------------------------------------------------------

### 3.1 Get All Categories
# @name getCategories
GET {{baseUrl}}/categories

### 3.2 Seller 1: Create Product (Laptop with Variants)
# @name createProduct1
POST {{baseUrl}}/seller/products
Authorization: Bearer {{seller1Token}}
Content-Type: application/json

{
  "category_id": 5,
  "name": "Laptop Gaming Legion Pro 5",
  "description": "Prosesor Ryzen 7, RAM 16GB, RTX 4060, SSD 1TB NVMe.",
  "price": 18500000,
  "stock": 10,
  "weight": 2400,
  "variants": [
    {
      "variant_name": "RAM 16GB / SSD 512GB",
      "price_override": 17500000,
      "stock": 5
    },
    {
      "variant_name": "RAM 32GB / SSD 1TB",
      "price_override": 19800000,
      "stock": 5
    }
  ]
}

### 3.3 Seller 2: Create Product (Hoodie Oversize)
# @name createProduct2
POST {{baseUrl}}/seller/products
Authorization: Bearer {{seller2Token}}
Content-Type: application/json

{
  "category_id": 2,
  "name": "Hoodie Oversize Unisex Cotton Fleece",
  "description": "Bahan katun fleece tebal, lembut dan nyaman dipakai sehari-hari.",
  "price": 149000,
  "stock": 100,
  "weight": 500,
  "variants": [
    {
      "variant_name": "Hitam - Size L",
      "stock": 50
    },
    {
      "variant_name": "Sage Green - Size XL",
      "stock": 50
    }
  ]
}

### 3.4 Public: List Products (Search & Filter)
GET {{baseUrl}}/products?search=Gaming&page=1&limit=10

### 3.5 Public: List All Products
GET {{baseUrl}}/products?page=1&limit=10

### 3.6 Public: Get Product Details
GET {{baseUrl}}/products/1


### --------------------------------------------------------------------
### 4. Wishlist Management
### --------------------------------------------------------------------

### 4.1 Buyer: Add Product 1 to Wishlist
POST {{baseUrl}}/wishlist/1
Authorization: Bearer {{buyerToken}}

### 4.2 Buyer: Get Wishlist Items
GET {{baseUrl}}/wishlist
Authorization: Bearer {{buyerToken}}

### 4.3 Buyer: Remove Product from Wishlist
DELETE {{baseUrl}}/wishlist/1
Authorization: Bearer {{buyerToken}}


### --------------------------------------------------------------------
### 5. Voucher & Promo System
### --------------------------------------------------------------------

### 5.1 Seller 1: Create Store Voucher (Diskon 5% Max 100rb)
# @name createStoreVoucher
POST {{baseUrl}}/seller/vouchers
Authorization: Bearer {{seller1Token}}
Content-Type: application/json

{
  "code": "GADGETHEMAT5",
  "voucher_type": "percentage",
  "discount_percent": 5.0,
  "max_discount": 100000,
  "min_spend": 500000,
  "quota": 50,
  "start_date": "2026-01-01T00:00:00Z",
  "end_date": "2026-12-31T23:59:59Z"
}

### 5.2 Public: List Available Platform Vouchers
GET {{baseUrl}}/vouchers

### 5.3 Public: List Available Store Vouchers
GET {{baseUrl}}/vouchers?store_id=1

### 5.4 Public / Buyer: Preview & Apply Voucher
POST {{baseUrl}}/vouchers/apply
Content-Type: application/json

{
  "code": "DISKON10",
  "total_amount": 18500000
}


### --------------------------------------------------------------------
### 6. Multi-Store Shopping Cart
### --------------------------------------------------------------------

### 6.1 Buyer: Add Laptop from Store 1 to Cart
# @name addToCartStore1
POST {{baseUrl}}/cart/items
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{
  "product_id": 1,
  "variant_id": 1,
  "quantity": 1
}

### 6.2 Buyer: Add Hoodie from Store 2 to Cart
# @name addToCartStore2
POST {{baseUrl}}/cart/items
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{
  "product_id": 2,
  "variant_id": 3,
  "quantity": 2
}

### 6.3 Buyer: View Multi-Store Cart (Grouped by Store)
# @name getCart
GET {{baseUrl}}/cart
Authorization: Bearer {{buyerToken}}

### 6.4 Buyer: Update Cart Item Quantity
PUT {{baseUrl}}/cart/items/1
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{
  "quantity": 1
}


### --------------------------------------------------------------------
### 7. Multi-Store Checkout, Payment Webhook & Escrow
### --------------------------------------------------------------------

### 7.1 Buyer: Checkout with Platform Voucher "DISKON10"
# @name checkout
POST {{baseUrl}}/orders/checkout
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{
  "address_id": 1,
  "voucher_code": "DISKON10",
  "payment_method": "BCA_VA",
  "stores": [
    {
      "store_id": 1,
      "courier_name": "JNE Reguler"
    },
    {
      "store_id": 2,
      "courier_name": "SiCepat BEST"
    }
  ]
}

@invoiceNumber = {{checkout.response.body.data.invoice_number}}
@finalAmount = {{checkout.response.body.data.final_amount}}

### 7.2 Payment Gateway: Webhook Notification (Simulated Payment Settlement)
POST {{baseUrl}}/payments/webhook
Content-Type: application/json

{
  "invoice_number": "{{invoiceNumber}}",
  "amount": {{finalAmount}},
  "payment_status": "SETTLEMENT"
}

### 7.3 Buyer: Get User Orders
GET {{baseUrl}}/orders
Authorization: Bearer {{buyerToken}}

### 7.4 Buyer: Get Order Detail
GET {{baseUrl}}/orders/1
Authorization: Bearer {{buyerToken}}

### 7.5 Seller 1: View Incoming Store Orders
# @name getStoreOrders
GET {{baseUrl}}/seller/orders
Authorization: Bearer {{seller1Token}}

### 7.6 Seller 1: Input Shipping Tracking Number
# @name shipOrderItem
PATCH {{baseUrl}}/seller/orders/1/ship
Authorization: Bearer {{seller1Token}}
Content-Type: application/json

{
  "tracking_number": "JNE-INV-99887766",
  "courier_name": "JNE Reguler"
}

### 7.7 Buyer: Confirm Order Completion (Releases Escrow to Seller 1 & Records Mutation)
# @name completeOrderItem
POST {{baseUrl}}/orders/items/1/complete
Authorization: Bearer {{buyerToken}}


### --------------------------------------------------------------------
### 8. Store Balance, Mutation Ledger & Withdrawal
### --------------------------------------------------------------------

### 8.1 Seller 1: Check Credited Store Balance
GET {{baseUrl}}/seller/balance
Authorization: Bearer {{seller1Token}}

### 8.2 Seller 1: View Mutation History / Audit Ledger
GET {{baseUrl}}/seller/mutations
Authorization: Bearer {{seller1Token}}

### 8.3 Seller 1: Request Bank Withdrawal (Payout)
# @name requestWithdrawal
POST {{baseUrl}}/seller/withdrawals
Authorization: Bearer {{seller1Token}}
Content-Type: application/json

{
  "bank_name": "BCA",
  "account_number": "0123456789",
  "account_holder": "Budi Seller Gadget",
  "amount": 5000000
}

### 8.4 Seller 1: View Withdrawal History
GET {{baseUrl}}/seller/withdrawals
Authorization: Bearer {{seller1Token}}


### --------------------------------------------------------------------
### 9. Review & Rating System
### --------------------------------------------------------------------

### 9.1 Buyer: Submit Review on Completed Order Item
# @name submitReview
POST {{baseUrl}}/reviews
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{
  "order_item_id": 1,
  "rating": 5,
  "comment": "Laptop original, packing kayu sangat aman dan pengiriman cepat!"
}

### 9.2 Public: View Product Reviews & Aggregated Rating
GET {{baseUrl}}/products/1/reviews

### 9.3 Public: Check Product Details (Rating stats updated)
GET {{baseUrl}}/products/1
